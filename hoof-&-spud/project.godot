; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hoof & Spud"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://resources/audio/default_bus_layout.tres"

[autoload]

GameClock="*res://scripts/systems/game_clock.gd"
Inventory="*res://scripts/systems/inventory.gd"
ItemRegistry="*res://scripts/systems/item_registry.gd"
Audio="*res://scripts/systems/audio.gd"
SaveGame="*res://scripts/systems/save_game.gd"
SceneSwap="*res://scripts/systems/scene_swap.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://resources/ui/farm_theme.tres"

